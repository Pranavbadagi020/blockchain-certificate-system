# ==============================================================================
# CertChain Environment Configuration Template
# Copy this file to .env and fill in required secrets for production deployment.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# ── Backend & Database Configuration ─────────────────────────────────────────
# MongoDB connection URI (e.g., MongoDB Atlas or managed instance)
MONGODB_URI=mongodb://localhost:27017/certchain

# System Administrator Credentials (Password must be >= 12 characters)
ADMIN_EMAIL=admin@certchain.local
ADMIN_PASSWORD=YourStrongAdminPasswordHere123!

# JWT Token Signing Secret (Must be >= 256 bits / 32 characters)
JWT_SECRET=YourVeryStrong256BitSecretKeyForProductionJwtSigning2026!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs of allowed frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://certchain.yourdomain.com

# ── Blockchain Configuration ─────────────────────────────────────────────────
# Ethereum-compatible JSON-RPC endpoint (e.g. Infura, Alchemy, QuickNode, or local node)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed CertificateRegistry smart contract address (0x...)
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Authorized issuing wallet private key (Without 0x prefix, or with 0x prefix)
# Used exclusively server-side to sign on-chain certificate registration transactions.
BLOCKCHAIN_PRIVATE_KEY=your_authorized_private_key_without_quotes

# ── Hardhat Testnet Deployment Configuration ──────────────────────────────────
# RPC URL for running Hardhat testnet deployments
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_PRIVATE_KEY=your_testnet_deployer_private_key

# ── AI-Assisted Document Analysis ─────────────────────────────────────────────
# Enable or disable AI document analysis feature (true/false)
AI_ANALYSIS_ENABLED=true

# AI Provider ("offline" for CertChain heuristic engine, "openai" for OpenAI API)
AI_PROVIDER=offline

# Optional OpenAI API Key (Only needed if AI_PROVIDER=openai)
AI_API_KEY=

# Optional OpenAI endpoint (Default: https://api.openai.com/v1/chat/completions)
AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# AI timeout in milliseconds
AI_TIMEOUT_MS=3000

# ── Frontend Configuration ───────────────────────────────────────────────────
# Base API URL used by the React client bundle during build
VITE_API_BASE_URL=http://localhost:8080/api
